FROM apache/spark:3.5.1

USER root

RUN pip3 install --no-cache-dir pyyaml python-dotenv \
    && mkdir -p /home/spark/.ivy2 \
    && chown -R spark:spark /home/spark

COPY --chown=185:185 src/ /app/src/
COPY --chown=185:185 configs/ /app/configs/
COPY --chown=185:185 scripts/spark_job.py /app/scripts/spark_job.py
RUN mkdir -p /app/logs /tmp/spark-checkpoints \
    && chown -R 185:185 /app/logs /tmp/spark-checkpoints

USER spark
WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV SPARK_MASTER=local[*]
ENV SPARK_CHECKPOINT_DIR=/tmp/spark-checkpoints

CMD ["/opt/spark/bin/spark-submit", \
     "--master", "local[*]", \
     "--packages", "org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1", \
     "--conf", "spark.ui.enabled=false", \
     "scripts/spark_job.py"]
