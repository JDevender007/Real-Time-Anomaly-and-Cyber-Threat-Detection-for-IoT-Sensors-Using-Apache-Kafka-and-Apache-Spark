# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iot_security
DATABASE_URL_SQLITE=sqlite:///data/processed/iot_security.db

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Spark
SPARK_MASTER=local[*]

# API
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
DASHBOARD_PORT=8501

# Simulation
SIMULATION_RATE=10
NUM_DEVICES=50

# Security
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Logging
LOG_LEVEL=INFO

# Random Seed
RANDOM_SEED=42
